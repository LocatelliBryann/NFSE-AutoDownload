# Certificado A1
PFX_PATH=certificado.pfx
PFX_PASSWORD=COLOQUE_A_SENHA

# Consulta por CPF
DOCUMENTO_PARAM_NAME=cpfConsulta
CPF_CONSULTA=COLOQUE_O_CPF_SEM_PONTOS

# API de distribuição de documentos por NSU
API_BASE_URL=https://adn.nfse.gov.br/contribuintes
DFE_ENDPOINT_TEMPLATE=/DFe/{nsu}

# Município emissor
MUNICIPALITY_NAME=Prefeitura de Joinville
MUNICIPALITY_PHONE=(47) 3431-3233
MUNICIPALITY_EMAIL=fiscalville@joinville.sc.gov.br
MUNICIPALITY_LOGO_PATH=logo-nfs-e-horizontal.png

# DANFSe NT 008 v1.02
DANFSE_INCLUDE_STUB=0
DANFSE_SUPPRESS_OPTIONAL_LINES=0
DANFSE_STRICT_FONTS=0

# Pasta de rede. Deixe vazio para não copiar.
NETWORK_PDF_DIR=\\SERVIDOR\CAMINHO\NFs Diárias

# Desempenho e tentativas
REQUEST_TIMEOUT=60
DEFAULT_BATCH_LIMIT=500
REQUEST_INTERVAL_SECONDS=0.35
PDF_MAX_WORKERS=4
MAX_RETRIES_429=3
MAX_RETRIES_SERVER=8
MAX_RETRIES_CONNECTION=5
RETRY_SERVER_SECONDS=5

FLASK_SECRET_KEY=altere-esta-chave
IBGE_MUNICIPALITIES_FILE=municipios_ibge.json
