# Copie este arquivo para .env e preencha os dados.

# Certificado A1 PFX/P12
PFX_PATH=certificado.pfx
PFX_PASSWORD=SENHA_DO_CERTIFICADO

# CNPJ do cartório, somente números
CNPJ_CONSULTA=00000000000000

# API oficial de produção dos contribuintes
API_BASE_URL=https://adn.nfse.gov.br/contribuintes

# Endpoint informado no manual oficial
DFE_ENDPOINT_TEMPLATE=/DFe/{nsu}

# O manual informa que há parâmetro para CNPJ de consulta.
# Confirme no Swagger atual se o nome continua sendo "cnpj".
CNPJ_PARAM_NAME=cnpj

REQUEST_TIMEOUT=60
MAX_CONSECUTIVE_EMPTY=3
DEFAULT_BATCH_LIMIT=500

# Opcional
# DATA_DIR=C:\NFSE_Downloader\dados
# DOWNLOAD_DIR=C:\NFSE_Downloader\dados\downloads
# DB_PATH=C:\NFSE_Downloader\dados\nfse.db
FLASK_SECRET_KEY=uso-local
